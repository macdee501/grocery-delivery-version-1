{
  "expo": {
    "name": "FreshCart",
    "slug": "freshcart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/avacodologo.png",
    "scheme": "freshcart",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.pain.freshcart",
      "supportsTablet": true
    },
    "android": {
      "package": "com.pain.freshcart",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/avacodologo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.pain.grocerydelivery",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c33657bb-46cb-4f6c-aac8-662da96f7351"
      }
    }
  }
}
